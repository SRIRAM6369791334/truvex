<%
  const searchPlaceholder = typeof placeholder !== 'undefined' ? placeholder : 'Search this table';
%>
<div class="toolbar" role="search">
  <input
    class="table-search"
    type="search"
    placeholder="<%= searchPlaceholder %>"
    aria-label="<%= searchPlaceholder %>"
    id="table-search-input"
  >
</div>
