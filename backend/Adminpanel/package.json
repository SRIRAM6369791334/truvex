{
  "name": "truvex-sourcing-admin-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Truvex Sourcing Express and React admin panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n api,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run check && vite build --config client/vite.config.ts",
    "check": "npm run check:server && npm run typecheck",
    "check:server": "node --check app.js && node --check server.js && node --check middleware/upload.js && node --check routes/authRoutes.js && node --check routes/dashboardRoutes.js && node --check routes/recordRoutes.js && node --check routes/serviceRoutes.js && node --check routes/categoryRoutes.js",
    "typecheck": "tsc -p client/tsconfig.json",
    "seed:admin": "node scripts/create-admin.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test tests/e2e.test.js",
    "test:client": "vitest run --config client/vite.config.ts"
  },
  "dependencies": {
    "@types/jquery": "^4.0.1",
    "@types/summernote": "^0.8.10",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "jquery": "^4.0.0",
    "lucide-react": "^1.21.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.0",
    "slugify": "^1.6.6",
    "summernote": "^0.9.1",
    "sweetalert2": "^11.26.25"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
