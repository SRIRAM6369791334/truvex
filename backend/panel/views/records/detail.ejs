<%- include('../partials/head', { title, user, currentPath, flash }) %>

<section class="panel" aria-label="<%= config.title %> detail">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Detail View</p>
      <h2><%= config.title %> <small class="muted">#<%= record.id %></small></h2>
    </div>
    <a class="button" href="/submissions/<%= resourceKey %>" aria-label="Back to <%= config.title %> list">← Back</a>
  </div>

  <div class="detail-grid">
    <% config.detailFields.forEach((field) => { %>
      <div class="detail-item">
        <span><%= field[1] %></span>
        <% if (field[0] === 'status') { %>
          <%- include('../partials/status-badge', { status: normalizeValue(record[field[0]]) }) %>
        <% } else if (field[0] === 'factory_images' && Array.isArray(record[field[0]])) { %>
          <div class="image-list">
            <% record[field[0]].forEach((image) => { %>
              <a href="<%= image %>" target="_blank" rel="noreferrer noopener"><%= image %></a>
            <% }) %>
            <% if (!record[field[0]].length) { %>
              <em class="muted">No images attached</em>
            <% } %>
          </div>
        <% } else { %>
          <strong><%= normalizeValue(record[field[0]]) || '—' %></strong>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>

<% if (config.statusOptions.length) { %>
  <section class="panel" aria-label="Workflow status update">
    <div class="panel-header">
      <div>
        <p class="eyebrow">Workflow</p>
        <h2>Update Status</h2>
      </div>
      <%- include('../partials/status-badge', { status: record.status }) %>
    </div>
    <form action="/submissions/<%= resourceKey %>/<%= record.id %>/status" method="post" class="form-grid compact">
      <%
        const selectContent = config.statusOptions.map(statusOption => {
          const selected = record.status === statusOption ? 'selected' : '';
          return `<option value="${statusOption}" ${selected}>${statusOption}</option>`;
        }).join('\n');
      %>
      <%- include('../partials/form-field', {
        id: 'status',
        label: 'New Status',
        type: 'select',
        selectContent: selectContent
      }) %>
      <% if (Object.prototype.hasOwnProperty.call(record, 'admin_notes')) { %>
        <%- include('../partials/form-field', {
          id: 'admin_notes',
          label: 'Admin Notes',
          type: 'textarea',
          value: record.admin_notes || '',
          className: 'wide',
          rows: 4,
          placeholder: 'Optional internal notes...'
        }) %>
      <% } %>
      <div class="form-actions wide">
        <button class="button primary" type="submit" id="save-status-btn">Save Status</button>
      </div>
    </form>
  </section>
<% } %>

<%- include('../partials/footer', { user }) %>
