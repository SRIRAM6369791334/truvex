<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Truvex Sourcing Admin Panel — Manage suppliers, buyers, services, and categories.">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> | Truvex Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    /* Visually hidden utility for screen-reader-only text */
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  </style>
</head>
<body>
  <% if (user) { %>
    <aside class="sidebar" aria-label="Main navigation">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">T</span>
        <div>
          <strong>Truvex</strong>
          <small>Admin Panel</small>
        </div>
      </div>
      <nav class="nav" aria-label="Primary">
        <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/" aria-current="<%= currentPath === '/' ? 'page' : 'false' %>">Dashboard</a>
        <a class="<%= currentPath.startsWith('/submissions/buyers') ? 'active' : '' %>" href="/submissions/buyers" aria-current="<%= currentPath.startsWith('/submissions/buyers') ? 'page' : 'false' %>">Buyers</a>
        <a class="<%= currentPath.startsWith('/submissions/suppliers') ? 'active' : '' %>" href="/submissions/suppliers" aria-current="<%= currentPath.startsWith('/submissions/suppliers') ? 'page' : 'false' %>">Suppliers</a>
        <a class="<%= currentPath.startsWith('/submissions/contacts') ? 'active' : '' %>" href="/submissions/contacts" aria-current="<%= currentPath.startsWith('/submissions/contacts') ? 'page' : 'false' %>">Contacts</a>
        <a class="<%= currentPath.startsWith('/submissions/rfq') ? 'active' : '' %>" href="/submissions/rfq" aria-current="<%= currentPath.startsWith('/submissions/rfq') ? 'page' : 'false' %>">RFQs</a>
        <a class="<%= currentPath.startsWith('/submissions/enquiries') ? 'active' : '' %>" href="/submissions/enquiries" aria-current="<%= currentPath.startsWith('/submissions/enquiries') ? 'page' : 'false' %>">Enquiries</a>
        <a class="<%= currentPath.startsWith('/submissions/service-leads') ? 'active' : '' %>" href="/submissions/service-leads" aria-current="<%= currentPath.startsWith('/submissions/service-leads') ? 'page' : 'false' %>">Service Leads</a>
        <a class="<%= currentPath.startsWith('/submissions/callbacks') ? 'active' : '' %>" href="/submissions/callbacks" aria-current="<%= currentPath.startsWith('/submissions/callbacks') ? 'page' : 'false' %>">Callbacks</a>
        <a class="<%= currentPath.startsWith('/submissions/newsletters') ? 'active' : '' %>" href="/submissions/newsletters" aria-current="<%= currentPath.startsWith('/submissions/newsletters') ? 'page' : 'false' %>">Newsletter</a>
        <a class="<%= currentPath.startsWith('/services') ? 'active' : '' %>" href="/services" aria-current="<%= currentPath.startsWith('/services') ? 'page' : 'false' %>">Services</a>
        <a class="<%= currentPath.startsWith('/categories') ? 'active' : '' %>" href="/categories" aria-current="<%= currentPath.startsWith('/categories') ? 'page' : 'false' %>">Categories</a>
      </nav>
    </aside>
    <main class="shell" id="main-content">
      <header class="topbar">
        <div>
          <p class="eyebrow">Truvex Sourcing</p>
          <h1><%= title %></h1>
        </div>
        <div class="userbar">
          <span aria-label="Logged in as <%= user.name %>"><%= user.name %></span>
          <form action="/logout" method="post">
            <button class="button ghost" type="submit" id="logout-btn">Logout</button>
          </form>
        </div>
      </header>
      <%- include('flash') %>
  <% } %>
