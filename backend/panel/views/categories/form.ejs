<%- include('../partials/head', { title, user, currentPath, flash }) %>

<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          display: ['Plus Jakarta Sans', 'ui-sans-serif', 'system-ui', 'sans-serif']
        },
        colors: {
          primary: {
            50: '#f0fdfa',
            100: '#ccfbf1',
            500: '#14b8a6',
            600: '#0d9488',
            700: '#0f766e',
            800: '#115e59',
          }
        }
      }
    }
  }
</script>

<style>
  /* Premium Design System Overrides */
  .bento-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.02), 0 2px 4px -2px rgba(15, 23, 42, 0.02);
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bento-card:hover {
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);
    transform: translateY(-2px);
  }
  
  .bento-header {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tw-input {
    width: 100%;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #0f172a;
    background: #ffffff;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.02);
  }
  .tw-input:focus {
    outline: none;
    border-color: #0d9488;
    box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.1);
  }
  
  .tw-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #category-submit-btn, #add-subcategory-btn {
    border-radius: 0.75rem;
    padding: 0.75rem 2rem;
    font-size: 1rem;
  }
</style>

<div class="mb-8 flex items-center justify-between border-b border-slate-200 pb-6">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-teal-600 mb-1">Catalog</p>
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 font-display"><%= title %></h2>
  </div>
  <a class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-semibold text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 hover:text-slate-900 hover:shadow-sm transition-all" href="/categories">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    Back
  </a>
</div>

<form action="<%= action %>" method="post" enctype="multipart/form-data" class="grid grid-cols-1 xl:grid-cols-3 gap-8" aria-label="<%= title %> form">
  
  <!-- Main Content Column -->
  <div class="xl:col-span-2 space-y-8">
    
    <div class="bento-card">
      <h3 class="bento-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
        Category Details
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="tw-label">Name <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="text" class="tw-input" name="name" value="<%= category.name %>" required placeholder="e.g. Electronics">
        </div>
        <div>
          <label class="tw-label">Slug</label>
          <input type="text" class="tw-input" name="slug" value="<%= category.slug %>" placeholder="auto-generated if blank">
        </div>
        <div class="md:col-span-2">
          <label class="tw-label">Description</label>
          <textarea class="tw-input" name="description" rows="3" placeholder="Brief description of this category..."><%= category.description %></textarea>
        </div>
        <div class="md:col-span-2">
          <label class="tw-label">Tags (one per line)</label>
          <textarea class="tw-input" name="tags" rows="4" placeholder="industrial\nmanufacturing\nB2B"><%= category.tags %></textarea>
        </div>
      </div>
    </div>

    <div class="bento-card">
      <h3 class="bento-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        Category Image
      </h3>
      <div>
        <p class="text-xs text-slate-500 mb-3">Required exact size: 800x600px. Max size: 2MB. Upload JPG, PNG, or WEBP.</p>
        <input type="file" id="image_file" class="tw-input bg-slate-50 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer" name="image_file" accept="image/jpeg, image/png, image/webp">
        
        <% if (category.image) { %>
          <div class="mt-4 flex items-center gap-4 p-3 bg-slate-50 rounded-xl border border-slate-200 w-max pr-6">
            <img src="<%= category.image %>" class="w-16 h-12 object-cover rounded shadow-sm">
            <div class="text-sm">
              <p class="font-semibold text-slate-900">Current Image</p>
              <a href="<%= category.image %>" target="_blank" class="text-teal-600 font-medium hover:text-teal-700">View Full Size</a>
            </div>
          </div>
          <input type="hidden" name="existing_image" value="<%= category.image %>">
        <% } %>
      </div>
    </div>

  </div> <!-- End Main Column -->

  <!-- Sidebar Column -->
  <div class="space-y-8">
    <div class="bento-card">
      <h3 class="bento-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
        Classification
      </h3>
      <div class="space-y-5">
        <div class="relative" id="icon-picker-container">
          <label class="tw-label">Icon Name</label>
          <input type="hidden" name="icon_name" id="icon_name_input" value="<%= category.icon_name %>" required>
          <button type="button" id="icon-picker-btn" class="tw-input flex items-center justify-between text-left cursor-pointer hover:bg-slate-50 transition-colors bg-white">
            <div class="flex items-center gap-3">
              <span id="selected-icon-preview" class="text-slate-500 flex items-center justify-center w-5 h-5">
              </span>
              <span id="selected-icon-text" class="font-medium">
                <%= category.icon_name || "Select an icon..." %>
              </span>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><path d="m6 9 6 6 6-6"/></svg>
          </button>

          <div id="icon-picker-popover" class="hidden absolute top-full left-0 z-50 w-[320px] mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden flex flex-col max-h-[380px]">
            <div class="p-3 border-b border-slate-100 bg-slate-50">
              <div class="relative">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" id="icon-search" class="w-full pl-9 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-all" placeholder="Search icons...">
              </div>
            </div>
            <div id="icon-grid" class="flex-1 overflow-y-auto p-3 grid grid-cols-4 gap-2 bg-white">
              <!-- Icons injected via JS -->
            </div>
          </div>
        </div>
        <div>
          <label class="tw-label">Sort Order</label>
          <input type="number" class="tw-input" name="sort_order" value="<%= category.sort_order %>" placeholder="0">
        </div>
        
        <div class="pt-5 mt-5 border-t border-slate-100 space-y-4">
          <label class="flex items-center gap-4 p-4 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors shadow-sm">
            <input type="checkbox" name="trending" <%= category.trending ? 'checked' : '' %> class="w-5 h-5 text-teal-600 rounded border-slate-300 focus:ring-teal-500">
            <span class="text-sm font-semibold text-slate-900">Trending Category</span>
          </label>
          <label class="flex items-center gap-4 p-4 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors shadow-sm">
            <input type="checkbox" name="is_active" <%= category.is_active ? 'checked' : '' %> class="w-5 h-5 text-teal-600 rounded border-slate-300 focus:ring-teal-500">
            <span class="text-sm font-semibold text-slate-900">Active / Published</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Actions Bento -->
    <div class="bento-card bg-slate-50 border-slate-200">
      <div class="flex flex-col gap-4">
        <button class="button primary !w-full !justify-center !py-3 !rounded-xl !text-base shadow-[0_4px_14px_0_rgba(13,148,136,0.39)] hover:shadow-[0_6px_20px_rgba(13,148,136,0.23)] hover:-translate-y-0.5 transition-all" type="submit" id="category-submit-btn"><%= submitLabel %></button>
        <% if (category.id) { %>
          <button
            class="button danger !w-full !justify-center !py-3 !rounded-xl hover:-translate-y-0.5 transition-all shadow-sm"
            formaction="/categories/<%= category.id %>/delete"
            data-confirm="Delete this category and its subcategories? This cannot be undone."
            type="submit"
            id="category-delete-btn"
          >Delete Category</button>
        <% } %>
      </div>
    </div>
  </div>
</form>

<% if (category.id) { %>
  <div class="mt-12 pt-10 border-t border-slate-200">
    <div class="mb-8">
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-teal-600 mb-1">Nested Catalog</p>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 font-display">Subcategories <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-sm ml-2"><%= subcategories.length %></span></h2>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
      <!-- Subcategories List -->
      <div class="xl:col-span-2 bento-card !p-0 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" aria-label="Subcategories table">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200">
                <th scope="col" class="py-4 px-6 text-xs font-bold uppercase tracking-wider text-slate-500">Name</th>
                <th scope="col" class="py-4 px-6 text-xs font-bold uppercase tracking-wider text-slate-500">Slug</th>
                <th scope="col" class="py-4 px-6 text-xs font-bold uppercase tracking-wider text-slate-500">Status</th>
                <th scope="col" class="py-4 px-6 text-xs font-bold uppercase tracking-wider text-slate-500 text-right"><span class="visually-hidden">Actions</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% subcategories.forEach((subcategory) => { %>
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-3">
                      <% if (subcategory.image) { %>
                        <img src="<%= subcategory.image %>" class="w-10 h-10 rounded-lg object-cover border border-slate-200 shadow-sm">
                      <% } %>
                      <strong class="text-slate-900"><%= subcategory.name %></strong>
                    </div>
                  </td>
                  <td class="py-4 px-6"><span class="text-sm text-slate-500"><%= subcategory.slug %></span></td>
                  <td class="py-4 px-6"><%- include('../partials/status-badge', { status: subcategory.is_active ? 'active' : 'inactive' }) %></td>
                  <td class="py-4 px-6 text-right">
                    <form action="/categories/<%= category.id %>/subcategories/<%= subcategory.id %>/delete" method="post" class="inline">
                      <button class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-red-50 text-red-600 hover:bg-red-500 hover:text-white transition-all border border-red-100 hover:border-red-500 shadow-sm" data-confirm="Delete this subcategory?" type="submit" aria-label="Delete <%= subcategory.name %>">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              <% if (!subcategories.length) { %>
                <tr><td colspan="4" class="py-8 px-6 text-center text-slate-500 italic">No subcategories added yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Subcategory Form -->
      <div class="bento-card h-max">
        <h3 class="bento-header">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Subcategory
        </h3>
        <form action="/categories/<%= category.id %>/subcategories" method="post" enctype="multipart/form-data" class="space-y-5" aria-label="Add subcategory">
          <div>
            <label class="tw-label">Name <span class="text-red-500 ml-1 text-base">*</span></label>
            <input type="text" class="tw-input" name="name" required placeholder="Subcategory name">
          </div>
          <div>
            <label class="tw-label">Slug</label>
            <input type="text" class="tw-input" name="slug" placeholder="auto-generated if blank">
          </div>
          <div>
            <label class="tw-label">Image</label>
            <input type="file" id="sub_image_file" class="tw-input bg-slate-50 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer" name="sub_image_file" accept="image/jpeg, image/png, image/webp">
          </div>
          <div>
            <label class="tw-label">Description</label>
            <textarea class="tw-input" name="description" rows="3"></textarea>
          </div>
          <div class="grid grid-cols-2 gap-4 pb-4">
            <div>
              <label class="tw-label">Sort Order</label>
              <input type="number" class="tw-input" name="sort_order" value="0">
            </div>
            <div class="flex items-end pb-2">
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" name="is_active" checked class="w-5 h-5 text-teal-600 rounded border-slate-300 focus:ring-teal-500 transition-colors">
                <span class="text-sm font-semibold text-slate-700 group-hover:text-slate-900 transition-colors">Active</span>
              </label>
            </div>
          </div>
          <button class="button primary !w-full !justify-center !py-3 !rounded-xl !text-base shadow-[0_4px_14px_0_rgba(13,148,136,0.39)] hover:shadow-[0_6px_20px_rgba(13,148,136,0.23)] hover:-translate-y-0.5 transition-all" type="submit" id="add-subcategory-btn">Add Subcategory</button>
        </form>
      </div>
    </div>
  </div>
<% } %>

<script>
  // Image Validation Logic for Categories (strictly 800x600 px limit as requested)
  document.addEventListener('change', (e) => {
    if (e.target.type === 'file' && e.target.accept.includes('image')) {
      const file = e.target.files[0];
      if (file) {
        if (file.size > 2 * 1024 * 1024) {
          alert('Error: Image size exceeds 2MB limit. Please upload a smaller image.');
          e.target.value = '';
          return;
        }

        const img = new Image();
        img.onload = function() {
          if (this.width !== 800 || this.height !== 600) {
            alert('Error: Image dimensions must be exactly 800x600px. Uploaded image is ' + this.width + 'x' + this.height + 'px.');
            e.target.value = '';
          }
        };
        img.src = URL.createObjectURL(file);
      }
    }
  });
</script>

<script src="https://unpkg.com/lucide@latest"></script>
<script>
  // Icon Picker Logic
  const CURATED_ICONS = [
    "box", "package", "truck", "settings", "tool", "shield", "globe", "zap",
    "archive", "briefcase", "building", "cpu", "factory", "hammer", "hard-hat", "layers",
    "anchor", "compass", "map", "navigation", "droplet", "flame", "wind", "sun",
    "activity", "award", "bar-chart", "check-circle", "clipboard", "clock", "credit-card",
    "database", "dollar-sign", "file-text", "folder", "gift", "headphones", "heart",
    "hexagon", "home", "image", "inbox", "info", "key", "layout", "link", "list",
    "lock", "mail", "map-pin", "message-square", "monitor", "paperclip", "pen-tool",
    "percent", "phone", "pie-chart", "printer", "radio", "refresh-cw", "repeat",
    "save", "scissors", "search", "send", "server", "share-2", "shield-check",
    "shopping-bag", "shopping-cart", "sliders", "smartphone", "speaker", "star",
    "tag", "target", "terminal", "thumbs-up", "trash-2", "trending-up", "tv",
    "umbrella", "unlock", "upload-cloud", "user", "user-check", "users", "video",
    "wifi", "wrench", "alert-circle", "alert-triangle", "bell", "camera", "cloud"
  ];
  
  const iconPickerBtn = document.getElementById('icon-picker-btn');
  const iconPickerPopover = document.getElementById('icon-picker-popover');
  const iconSearch = document.getElementById('icon-search');
  const iconGrid = document.getElementById('icon-grid');
  const iconNameInput = document.getElementById('icon_name_input');
  const selectedIconPreview = document.getElementById('selected-icon-preview');
  const selectedIconText = document.getElementById('selected-icon-text');

  if (iconPickerBtn) {
    const initialIcon = iconNameInput.value;
    if (initialIcon) {
      selectedIconPreview.innerHTML = `<i data-lucide="${initialIcon}"></i>`;
    } else {
      selectedIconPreview.innerHTML = `<div class="w-4 h-4 rounded-full bg-slate-100 border border-slate-200 border-dashed"></div>`;
    }
    lucide.createIcons();

    iconPickerBtn.addEventListener('click', (e) => {
      e.preventDefault();
      iconPickerPopover.classList.toggle('hidden');
      if (!iconPickerPopover.classList.contains('hidden')) {
        iconSearch.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (!iconPickerBtn.contains(e.target) && !iconPickerPopover.contains(e.target)) {
        iconPickerPopover.classList.add('hidden');
      }
    });

    function renderIcons(searchQuery = '') {
      iconGrid.innerHTML = '';
      const filtered = CURATED_ICONS.filter(name => name.includes(searchQuery.toLowerCase()));
      
      if (filtered.length === 0) {
        iconGrid.innerHTML = `<div class="col-span-4 text-center py-8 text-sm text-slate-400">No icons found</div>`;
        return;
      }

      filtered.forEach(name => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isSelected = iconNameInput.value === name;
        btn.className = `flex flex-col items-center justify-center p-3 gap-2 rounded-xl border transition-all ${isSelected ? 'bg-teal-50 border-teal-200 text-teal-700 shadow-sm' : 'border-transparent text-slate-600 hover:bg-teal-50 hover:border-teal-100 hover:text-teal-700'}`;
        btn.innerHTML = `<i data-lucide="${name}" class="w-5 h-5"></i><span class="text-[10px] truncate w-full text-center">${name}</span>`;
        btn.addEventListener('click', () => {
          iconNameInput.value = name;
          selectedIconText.textContent = name;
          selectedIconPreview.innerHTML = `<i data-lucide="${name}"></i>`;
          iconPickerPopover.classList.add('hidden');
          lucide.createIcons();
          renderIcons(iconSearch.value); 
        });
        iconGrid.appendChild(btn);
      });
      lucide.createIcons();
    }

    iconSearch.addEventListener('input', (e) => {
      renderIcons(e.target.value);
    });

    renderIcons();
  }
</script>

<%- include('../partials/footer', { user }) %>
