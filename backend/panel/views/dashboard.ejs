<%- include('partials/head', { title, user, currentPath, flash }) %>

<!-- Welcome Banner -->
<div class="welcome-banner">
  <div>
    <p class="eyebrow">Welcome back</p>
    <h2 class="welcome-title"><%= user.name %></h2>
    <p class="welcome-sub">Here's what's happening in your sourcing platform today.</p>
  </div>
  <div class="welcome-date">
    <span id="live-date"></span>
  </div>
</div>

<!-- Stat Cards -->
<section class="stat-grid">
  <% const icons = ['package','factory','shopping-bag','clipboard-list','phone','message-square','bell','mail','wrench','folder']; %>
  <% stats.forEach((stat, i) => { %>
    <article class="stat-card">
      <div class="stat-icon"><i data-lucide="<%= icons[i % icons.length] %>"></i></div>
      <span><%= stat.label %></span>
      <strong><%= stat.total %></strong>
      <a class="stat-link" href="<%= stat.link %>">View all →</a>
    </article>
  <% }) %>
</section>

<!-- Recent Activity -->
<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Overview</p>
      <h2>Recent Activity</h2>
    </div>
    <span class="count"><%= recentActivity.length %> entries</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Type</th>
          <th>Name</th>
          <th>Meta</th>
          <th>Status</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% recentActivity.forEach((item) => { %>
          <tr>
            <td><span class="pill"><%= item.resource %></span></td>
            <td class="fw-medium"><%= item.title %></td>
            <td class="text-muted"><%= item.meta || '—' %></td>
            <td><%- include('partials/status-badge', { status: item.status }) %></td>
            <td class="text-muted text-sm"><%= item.created_at ? new Date(item.created_at).toLocaleString('en-IN', { dateStyle:'medium', timeStyle:'short' }) : '—' %></td>
            <td><a class="button small" href="/submissions/<%= item.resource %>/<%= item.id %>">Open →</a></td>
          </tr>
        <% }) %>
        <% if (!recentActivity.length) { %>
          <tr><td colspan="6" class="empty">✨ No recent activity yet. Submissions will appear here.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<script>
  const el = document.getElementById('live-date');
  if (el) el.textContent = new Date().toLocaleDateString('en-IN', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
</script>

<%- include('partials/footer', { user }) %>
