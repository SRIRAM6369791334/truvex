<%- include('../partials/head', { title, user, currentPath, flash }) %>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Catalog</p>
      <h2>Services</h2>
    </div>
    <a class="button primary" href="/services/new" id="new-service-btn">＋ New Service</a>
  </div>
  <%- include('../partials/search-toolbar', { placeholder: 'Search services by title or slug...' }) %>

  <div class="table-wrap">
    <table data-searchable>
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% services.forEach((service) => { %>
          <tr>
            <td>
              <span class="fw-medium"><%= service.title %></span><br>
              <small class="text-muted"><%= service.slug %></small>
            </td>
            <td>
              <% if (service.category_name) { %>
                <span class="pill"><%= service.category_name %></span>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </td>
            <td class="fw-medium">
              <%= service.price ? `₹${Number(service.price).toLocaleString('en-IN')} / ${service.price_unit}` : '—' %>
            </td>
            <td><%- include('../partials/status-badge', { status: service.in_stock ? 'in stock' : 'out' }) %></td>
            <td><%- include('../partials/status-badge', { status: service.is_active ? 'active' : 'inactive' }) %></td>
            <td><a class="button small" href="/services/<%= service.id %>/edit">Edit →</a></td>
          </tr>
        <% }) %>
        <% if (!services.length) { %>
          <tr><td colspan="6" class="empty">No services created yet. <a href="/services/new">Create your first →</a></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer', { user }) %>
