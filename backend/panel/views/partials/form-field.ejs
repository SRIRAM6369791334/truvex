<%
  const fieldType = typeof type !== 'undefined' ? type : 'text';
  const fieldName = typeof name !== 'undefined' ? name : id;
  const fieldValue = typeof value !== 'undefined' ? value : '';
  const fieldRequired = (typeof required !== 'undefined' && required) ? 'required' : '';
  const fieldAutofocus = (typeof autofocus !== 'undefined' && autofocus) ? 'autofocus' : '';
  const fieldPlaceholder = typeof placeholder !== 'undefined' ? placeholder : '';
  const fieldClass = typeof className !== 'undefined' ? className : '';
  const fieldRows = typeof rows !== 'undefined' ? rows : 3;
  const fieldStep = typeof step !== 'undefined' ? `step="${step}"` : '';
  const fieldChecked = (typeof checked !== 'undefined' && checked) ? 'checked' : '';
  const requiredAsterisk = fieldRequired ? '<span style="color: #ef4444; margin-left: 3px;" aria-hidden="true">*</span>' : '';
%>

<% if (fieldType === 'checkbox') { %>
  <label for="<%= id %>" class="check-row <%= fieldClass %>">
    <input type="checkbox" id="<%= id %>" name="<%= fieldName %>" <%= fieldChecked %> <%= fieldRequired %>>
    <span><%= label %><%- requiredAsterisk %></span>
  </label>
<% } else if (fieldType === 'textarea') { %>
  <label for="<%= id %>" class="<%= fieldClass %>">
    <span><%= label %><%- requiredAsterisk %></span>
    <textarea id="<%= id %>" name="<%= fieldName %>" rows="<%= fieldRows %>" <%= fieldRequired %> placeholder="<%= fieldPlaceholder %>" <%= fieldAutofocus %>><%= fieldValue %></textarea>
  </label>
<% } else if (fieldType === 'select') { %>
  <label for="<%= id %>" class="<%= fieldClass %>">
    <span><%= label %><%- requiredAsterisk %></span>
    <select id="<%= id %>" name="<%= fieldName %>" <%= fieldRequired %> <%= fieldAutofocus %>>
      <%- selectContent %>
    </select>
  </label>
<% } else { %>
  <label for="<%= id %>" class="<%= fieldClass %>">
    <span><%= label %><%- requiredAsterisk %></span>
    <input type="<%= fieldType %>" id="<%= id %>" name="<%= fieldName %>" value="<%= fieldValue %>" <%= fieldRequired %> placeholder="<%= fieldPlaceholder %>" <%= fieldAutofocus %> <%- fieldStep %>>
  </label>
<% } %>
