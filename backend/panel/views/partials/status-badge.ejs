<%
  let badgeColorClass = '';
  const cleanStatus = (status || '').toLowerCase().trim();
  if (['approved', 'active', 'completed'].includes(cleanStatus)) {
    badgeColorClass = 'green';
  } else if (['pending', 'contacted', 'new', 'processing'].includes(cleanStatus)) {
    badgeColorClass = 'amber';
  } else if (['rejected', 'suspended', 'inactive', 'out'].includes(cleanStatus)) {
    badgeColorClass = 'red';
  } else if (['read', 'replied'].includes(cleanStatus)) {
    badgeColorClass = 'blue';
  } else {
    badgeColorClass = 'gray';
  }
%><span class="status <%= badgeColorClass %>"><%= status %></span>
