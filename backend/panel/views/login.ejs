<%- include('partials/head', { title, user: null, currentPath: '/login', flash }) %>
<div class="login-page">
  <section class="login-card">
    <div class="brand login-brand">
      <span class="brand-mark">T</span>
      <div>
        <strong>Truvex</strong>
        <small>Sourcing Platform</small>
      </div>
    </div>

    <h1>Welcome back</h1>
    <p>Sign in to manage sourcing submissions, suppliers, services, and categories.</p>

    <%- include('partials/flash') %>

    <form action="/login" method="post" class="form-stack">
      <%- include('partials/form-field', { id: 'email', label: 'Email address', type: 'email', value: email, required: true, autofocus: true, placeholder: 'admin@truvex.com' }) %>
      <%- include('partials/form-field', { id: 'password', label: 'Password', type: 'password', required: true, placeholder: '••••••••' }) %>
      <button class="button primary full" type="submit" id="login-submit-btn">Sign In →</button>
    </form>
  </section>
</div>
<%- include('partials/footer', { user: null }) %>
