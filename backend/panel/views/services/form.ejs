<%- include('../partials/head', { title, user, currentPath, flash }) %>

<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          display: ['Plus Jakarta Sans', 'ui-sans-serif', 'system-ui', 'sans-serif']
        },
        colors: {
          primary: {
            50: '#f0fdfa',
            100: '#ccfbf1',
            500: '#14b8a6',
            600: '#0d9488',
            700: '#0f766e',
            800: '#115e59',
          }
        }
      }
    }
  }
</script>

<style>
  /* Premium Design System Overrides */
  .bento-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem; /* 24px rounded corners */
    padding: 2rem;
    box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.02), 0 2px 4px -2px rgba(15, 23, 42, 0.02);
    transition: box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bento-card:hover {
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);
    transform: translateY(-2px);
  }
  
  .bento-header {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Form inputs in Tailwind context */
  .tw-input {
    width: 100%;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #0f172a;
    background: #ffffff;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.02);
  }
  .tw-input:focus {
    outline: none;
    border-color: #0d9488;
    box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.1);
  }
  
  .tw-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Dynamic Rows */
  .dynamic-row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    background: #f8fafc;
    padding: 0.75rem;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    transition: background 0.2s ease;
  }
  .dynamic-row:hover {
    background: #f1f5f9;
  }

  .btn-remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: #fef2f2;
    color: #ef4444;
    border: 1px solid #fca5a5;
    border-radius: 0.5rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    flex-shrink: 0;
  }
  .btn-remove:hover {
    background: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
  }

  .btn-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: #ffffff;
    color: #0f172a;
    border: 1px dashed #cbd5e1;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    width: 100%;
    margin-top: 0.75rem;
  }
  .btn-add:hover {
    background: #f8fafc;
    border-color: #94a3b8;
    transform: translateY(-1px);
  }

  #service-submit-btn {
    border-radius: 0.75rem;
    padding: 0.75rem 2rem;
    font-size: 1rem;
  }
</style>

<div class="mb-8 flex items-center justify-between border-b border-slate-200 pb-6">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-teal-600 mb-1">Catalog</p>
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 font-display"><%= title %></h2>
  </div>
  <a class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-semibold text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 hover:text-slate-900 hover:shadow-sm transition-all" href="/services">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    Back
  </a>
</div>

<form action="<%= action %>" method="post" enctype="multipart/form-data" class="grid grid-cols-1 xl:grid-cols-3 gap-8" aria-label="<%= title %> form">
  
  <!-- Main Content Column (Left - 2/3) -->
  <div class="xl:col-span-2 space-y-8">
    
    <!-- Basic Information Bento -->
    <div class="bento-card">
      <h3 class="bento-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
        Basic Details
      </h3>
      <div class="grid grid-cols-1 gap-6">
        <div>
          <label class="tw-label">Title <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="text" class="tw-input" name="title" value="<%= service.title %>" required placeholder="e.g. Bulk Steel Sourcing">
        </div>
        <div>
          <label class="tw-label">Slug <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="text" class="tw-input" name="slug" value="<%= service.slug %>" required placeholder="auto-generated if blank">
        </div>
        <div>
          <label class="tw-label">Short Description <span class="text-red-500 ml-1 text-base">*</span></label>
          <textarea class="tw-input" name="description" rows="3" required placeholder="Brief overview shown in listings..."><%= service.description %></textarea>
        </div>
        <div>
          <label class="tw-label">Long Description <span class="text-red-500 ml-1 text-base">*</span></label>
          <textarea class="tw-input" name="long_description" rows="6" required placeholder="Detailed description for the service page..."><%= service.long_description %></textarea>
        </div>
      </div>
    </div>

    <!-- Media Assets Bento -->
    <div class="bento-card">
      <h3 class="bento-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        Media Assets
      </h3>
      
      <div class="space-y-8">
        <div>
          <label class="tw-label">Main Image <span class="text-red-500 ml-1 text-base">*</span></label>
          <p class="text-xs text-slate-500 mb-3">Required exact size: 800x600px. Max size: 2MB. Upload JPG, PNG, or WEBP.</p>
          <input type="file" id="image_file" class="tw-input bg-slate-50 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer" name="image_file" accept="image/jpeg, image/png, image/webp" <%= !service.image && !service.id ? 'required' : '' %>>
          
          <% if (service.image) { %>
            <div class="mt-3 flex items-center gap-4 p-3 bg-slate-50 rounded-xl border border-slate-200 w-max pr-6">
              <img src="<%= service.image %>" class="w-16 h-12 object-cover rounded shadow-sm">
              <div class="text-sm">
                <p class="font-semibold text-slate-900">Current Image</p>
                <a href="<%= service.image %>" target="_blank" class="text-teal-600 font-medium hover:text-teal-700">View Full Size</a>
              </div>
            </div>
            <input type="hidden" name="existing_image" value="<%= service.image %>">
          <% } %>
        </div>

        <div>
          <label class="tw-label">Gallery Images <span class="text-red-500 ml-1 text-base">*</span></label>
          <p class="text-xs text-slate-500 mb-3">Required exact size: 800x600px. Max size: 2MB. Note: Uploading new images will replace the current gallery.</p>
          
          <div id="gallery-container" class="space-y-3">
            <div class="dynamic-row">
              <input type="file" class="tw-input bg-white flex-1 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer" name="gallery_files" accept="image/jpeg, image/png, image/webp" required>
              <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
          </div>
          <button type="button" class="btn-add" onclick="addGalleryImage()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Add Another Image
          </button>

          <% if (service.images && service.images.length > 0) { %>
            <div class="mt-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
              <p class="text-sm font-semibold text-slate-900 mb-3">Current Gallery (<%= service.images.length %> images)</p>
              <div class="flex gap-3 overflow-x-auto pb-2">
                <% service.images.forEach((img, idx) => { %>
                   <a href="<%= img %>" target="_blank" class="shrink-0 relative group rounded-lg overflow-hidden border border-slate-200 shadow-sm block w-20 h-16">
                     <img src="<%= img %>" class="w-full h-full object-cover transition-transform group-hover:scale-110">
                   </a>
                <% }) %>
              </div>
            </div>
            <input type="hidden" name="existing_images" value="<%= JSON.stringify(service.images) %>">
          <% } %>
        </div>
      </div>
    </div>

    <!-- Deep Details Bento -->
    <div class="bento-card">
      <h3 class="bento-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Features & Deep Details
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div>
          <label class="tw-label">Features (one per line) <span class="text-red-500 ml-1 text-base">*</span></label>
          <textarea class="tw-input" name="features" rows="5" required placeholder="High quality\nFast delivery"><%= service.features %></textarea>
        </div>
        <div>
          <label class="tw-label">Benefits (one per line) <span class="text-red-500 ml-1 text-base">*</span></label>
          <textarea class="tw-input" name="benefits" rows="5" required placeholder="Cost savings\nReliable supply"><%= service.benefits %></textarea>
        </div>
      </div>

      <div class="space-y-8">
        <!-- Process Steps -->
        <div>
          <label class="tw-label">Process Steps <span class="text-red-500 ml-1 text-base">*</span></label>
          <div id="process-steps-container" class="space-y-3">
            <% if (service.process_steps && service.process_steps.length > 0) { %>
              <% service.process_steps.forEach(step => { %>
                <div class="dynamic-row">
                  <input type="text" class="tw-input flex-1" name="process_steps_arr[]" value="<%= step %>" placeholder="Enter step description" required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </div>
              <% }) %>
            <% } else { %>
                <div class="dynamic-row">
                  <input type="text" class="tw-input flex-1" name="process_steps_arr[]" value="" placeholder="Enter step description" required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </div>
            <% } %>
          </div>
          <button type="button" class="btn-add" onclick="addProcessStep()">+ Add Step</button>
        </div>

        <!-- Stats -->
        <div>
          <label class="tw-label">Statistics <span class="text-red-500 ml-1 text-base">*</span></label>
          <div id="stats-container" class="space-y-3">
            <% if (service.stats && service.stats.length > 0) { %>
              <% service.stats.forEach(stat => { %>
                <div class="dynamic-row">
                  <input type="text" class="tw-input w-1/3" name="stats_keys[]" value="<%= stat.label || '' %>" placeholder="Label (e.g. Clients)" required>
                  <input type="text" class="tw-input flex-1" name="stats_values[]" value="<%= stat.value || '' %>" placeholder="Value (e.g. 200+)" required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </div>
              <% }) %>
            <% } else { %>
                <div class="dynamic-row">
                  <input type="text" class="tw-input w-1/3" name="stats_keys[]" value="" placeholder="Label (e.g. Clients)" required>
                  <input type="text" class="tw-input flex-1" name="stats_values[]" value="" placeholder="Value (e.g. 200+)" required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </div>
            <% } %>
          </div>
          <button type="button" class="btn-add" onclick="addStatRow()">+ Add Stat</button>
        </div>

        <!-- Specifications -->
        <div>
          <label class="tw-label">Specifications <span class="text-red-500 ml-1 text-base">*</span></label>
          <div id="specs-container" class="space-y-3">
            <% if (service.specs && Object.keys(service.specs).length > 0) { %>
              <% Object.keys(service.specs).forEach(key => { %>
                <div class="dynamic-row">
                  <input type="text" class="tw-input w-1/3" name="specs_keys[]" value="<%= key %>" placeholder="Spec Name (e.g. Material)" required>
                  <input type="text" class="tw-input flex-1" name="specs_values[]" value="<%= service.specs[key] %>" placeholder="Spec Value (e.g. Steel)" required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </div>
              <% }) %>
            <% } else { %>
                <div class="dynamic-row">
                  <input type="text" class="tw-input w-1/3" name="specs_keys[]" value="" placeholder="Spec Name (e.g. Material)" required>
                  <input type="text" class="tw-input flex-1" name="specs_values[]" value="" placeholder="Spec Value (e.g. Steel)" required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </div>
            <% } %>
          </div>
          <button type="button" class="btn-add" onclick="addSpecRow()">+ Add Spec</button>
        </div>
      </div>
    </div>

  </div> <!-- End Left Column -->

  <!-- Sidebar Column (Right - 1/3) -->
  <div class="space-y-8">
    
    <!-- Classification Bento -->
    <div class="bento-card">
      <h3 class="bento-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
        Classification
      </h3>
      <div class="space-y-5">
        <div>
          <label class="tw-label">Category <span class="text-red-500 ml-1 text-base">*</span></label>
          <select class="tw-input cursor-pointer" id="category_id" name="category_id" required>
            <option value="">— Unassigned —</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>" <%= Number(service.category_id) === Number(c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="tw-label">Subcategory <span class="text-red-500 ml-1 text-base">*</span></label>
          <select class="tw-input cursor-pointer" id="subcategory_id" name="subcategory_id" data-selected="<%= service.subcategory_id || '' %>" required>
            <option value="">— Unassigned —</option>
          </select>
        </div>
        <div class="relative" id="icon-picker-container">
          <label class="tw-label">Icon Name <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="hidden" name="icon_name" id="icon_name_input" value="<%= service.icon_name %>" required>
          <button type="button" id="icon-picker-btn" class="tw-input flex items-center justify-between text-left cursor-pointer hover:bg-slate-50 transition-colors bg-white">
            <div class="flex items-center gap-3">
              <span id="selected-icon-preview" class="text-slate-500 flex items-center justify-center w-5 h-5">
              </span>
              <span id="selected-icon-text" class="font-medium">
                <%= service.icon_name || "Select an icon..." %>
              </span>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><path d="m6 9 6 6 6-6"/></svg>
          </button>

          <div id="icon-picker-popover" class="hidden absolute top-full left-0 z-50 w-[320px] mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden flex flex-col max-h-[380px]">
            <div class="p-3 border-b border-slate-100 bg-slate-50">
              <div class="relative">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" id="icon-search" class="w-full pl-9 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-all" placeholder="Search icons...">
              </div>
            </div>
            <div id="icon-grid" class="flex-1 overflow-y-auto p-3 grid grid-cols-4 gap-2 bg-white">
              <!-- Icons injected via JS -->
            </div>
          </div>
        </div>
        <div>
          <label class="tw-label">Sort Order <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="number" class="tw-input" name="sort_order" value="<%= service.sort_order %>" required placeholder="0">
        </div>
        
        <div class="pt-5 mt-5 border-t border-slate-100 space-y-4">
          <label class="flex items-center gap-4 p-4 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors shadow-sm">
            <input type="checkbox" name="in_stock" <%= service.in_stock ? 'checked' : '' %> class="w-5 h-5 text-teal-600 rounded border-slate-300 focus:ring-teal-500">
            <span class="text-sm font-semibold text-slate-900">In Stock</span>
          </label>
          <label class="flex items-center gap-4 p-4 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors shadow-sm">
            <input type="checkbox" name="is_active" <%= service.is_active ? 'checked' : '' %> class="w-5 h-5 text-teal-600 rounded border-slate-300 focus:ring-teal-500">
            <span class="text-sm font-semibold text-slate-900">Active / Published</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Commercial Bento -->
    <div class="bento-card">
      <h3 class="bento-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-600"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Commercial Details
      </h3>
      <div class="space-y-5">
        <div>
          <label class="tw-label">Price (Rs.) <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="number" step="0.01" class="tw-input font-mono" name="price" value="<%= service.price %>" required placeholder="0.00">
        </div>
        <div>
          <label class="tw-label">Price Unit <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="text" class="tw-input" name="price_unit" value="<%= service.price_unit %>" required placeholder="e.g. per kg, per MT">
        </div>
        <div>
          <label class="tw-label">Minimum Order Quantity (MOQ) <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="text" class="tw-input" name="moq" value="<%= service.moq %>" required placeholder="e.g. 500 Units">
        </div>
        <div>
          <label class="tw-label">Delivery Info <span class="text-red-500 ml-1 text-base">*</span></label>
          <input type="text" class="tw-input" name="delivery_info" value="<%= service.delivery_info %>" required placeholder="e.g. 7-10 Business Days">
        </div>
      </div>
    </div>

    <!-- Actions Bento -->
    <div class="bento-card bg-slate-50 border-slate-200">
      <div class="flex flex-col gap-4">
        <button class="button primary !w-full !justify-center !py-3 !rounded-xl !text-base shadow-[0_4px_14px_0_rgba(13,148,136,0.39)] hover:shadow-[0_6px_20px_rgba(13,148,136,0.23)] hover:-translate-y-0.5 transition-all" type="submit" id="service-submit-btn"><%= submitLabel %></button>
        <% if (service.id) { %>
          <button
            class="button danger !w-full !justify-center !py-3 !rounded-xl hover:-translate-y-0.5 transition-all shadow-sm"
            formaction="/services/<%= service.id %>/delete"
            data-confirm="Delete this service? This cannot be undone."
            type="submit"
            id="service-delete-btn"
          >Delete Service</button>
        <% } %>
      </div>
    </div>

  </div> <!-- End Right Column -->
</form>

<script>
  // Image Validation Logic
  document.addEventListener('change', (e) => {
    if (e.target.type === 'file' && e.target.accept.includes('image')) {
      const file = e.target.files[0];
      if (file) {
        // Size validation (Max 2MB)
        if (file.size > 2 * 1024 * 1024) {
          alert('Error: Image size exceeds 2MB limit. Please upload a smaller image.');
          e.target.value = '';
          return;
        }

        // Dimension validation (Exact 800x600)
        const img = new Image();
        img.onload = function() {
          if (this.width !== 800 || this.height !== 600) {
            alert('Error: Image dimensions must be exactly 800x600px. Uploaded image is ' + this.width + 'x' + this.height + 'px.');
            e.target.value = '';
          }
        };
        img.src = URL.createObjectURL(file);
      }
    }
  });

  // Subcategory Fetch Logic
  document.addEventListener('DOMContentLoaded', () => {
    const categorySelect = document.getElementById('category_id');
    const subcategorySelect = document.getElementById('subcategory_id');
    const initialSubcategory = subcategorySelect.getAttribute('data-selected');

    function fetchSubcategories(categoryId, selectedId = null) {
      subcategorySelect.innerHTML = '<option value="">— Unassigned —</option>';
      if (!categoryId) return;

      fetch(`/categories/${categoryId}/subcategories/json`)
        .then(res => res.json())
        .then(data => {
          data.forEach(sub => {
            const option = document.createElement('option');
            option.value = sub.id;
            option.textContent = sub.name;
            if (selectedId && String(selectedId) === String(sub.id)) {
              option.selected = true;
            }
            subcategorySelect.appendChild(option);
          });
        })
        .catch(err => console.error("Error fetching subcategories:", err));
    }

    categorySelect.addEventListener('change', (e) => {
      fetchSubcategories(e.target.value);
    });

    if (categorySelect.value) {
      fetchSubcategories(categorySelect.value, initialSubcategory);
    }
  });

  // Dynamic Rows Logic
  function addGalleryImage() {
    const container = document.getElementById('gallery-container');
    const row = document.createElement('div');
    row.className = 'dynamic-row';
    row.innerHTML = `
      <input type="file" class="tw-input bg-white flex-1 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer" name="gallery_files" accept="image/jpeg, image/png, image/webp" required>
      <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    `;
    container.appendChild(row);
  }

  function addProcessStep() {
    const container = document.getElementById('process-steps-container');
    const row = document.createElement('div');
    row.className = 'dynamic-row';
    row.innerHTML = `
      <input type="text" class="tw-input flex-1" name="process_steps_arr[]" placeholder="Enter step description" required>
      <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    `;
    container.appendChild(row);
  }

  function addStatRow() {
    const container = document.getElementById('stats-container');
    const row = document.createElement('div');
    row.className = 'dynamic-row';
    row.innerHTML = `
      <input type="text" class="tw-input w-1/3" name="stats_keys[]" placeholder="Label (e.g. Clients)" required>
      <input type="text" class="tw-input flex-1" name="stats_values[]" placeholder="Value (e.g. 200+)" required>
      <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    `;
    container.appendChild(row);
  }

  function addSpecRow() {
    const container = document.getElementById('specs-container');
    const row = document.createElement('div');
    row.className = 'dynamic-row';
    row.innerHTML = `
      <input type="text" class="tw-input w-1/3" name="specs_keys[]" placeholder="Spec Name (e.g. Material)" required>
      <input type="text" class="tw-input flex-1" name="specs_values[]" placeholder="Spec Value (e.g. Steel)" required>
      <button type="button" class="btn-remove" onclick="this.parentElement.remove()" title="Remove">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    `;
    container.appendChild(row);
  }
</script>

<script src="https://unpkg.com/lucide@latest"></script>
<script>
  // Icon Picker Logic
  const CURATED_ICONS = [
    "box", "package", "truck", "settings", "tool", "shield", "globe", "zap",
    "archive", "briefcase", "building", "cpu", "factory", "hammer", "hard-hat", "layers",
    "anchor", "compass", "map", "navigation", "droplet", "flame", "wind", "sun",
    "activity", "award", "bar-chart", "check-circle", "clipboard", "clock", "credit-card",
    "database", "dollar-sign", "file-text", "folder", "gift", "headphones", "heart",
    "hexagon", "home", "image", "inbox", "info", "key", "layout", "link", "list",
    "lock", "mail", "map-pin", "message-square", "monitor", "paperclip", "pen-tool",
    "percent", "phone", "pie-chart", "printer", "radio", "refresh-cw", "repeat",
    "save", "scissors", "search", "send", "server", "share-2", "shield-check",
    "shopping-bag", "shopping-cart", "sliders", "smartphone", "speaker", "star",
    "tag", "target", "terminal", "thumbs-up", "trash-2", "trending-up", "tv",
    "umbrella", "unlock", "upload-cloud", "user", "user-check", "users", "video",
    "wifi", "wrench", "alert-circle", "alert-triangle", "bell", "camera", "cloud"
  ];
  
  const iconPickerBtn = document.getElementById('icon-picker-btn');
  const iconPickerPopover = document.getElementById('icon-picker-popover');
  const iconSearch = document.getElementById('icon-search');
  const iconGrid = document.getElementById('icon-grid');
  const iconNameInput = document.getElementById('icon_name_input');
  const selectedIconPreview = document.getElementById('selected-icon-preview');
  const selectedIconText = document.getElementById('selected-icon-text');

  if (iconPickerBtn) {
    const initialIcon = iconNameInput.value;
    if (initialIcon) {
      selectedIconPreview.innerHTML = `<i data-lucide="${initialIcon}"></i>`;
    } else {
      selectedIconPreview.innerHTML = `<div class="w-4 h-4 rounded-full bg-slate-100 border border-slate-200 border-dashed"></div>`;
    }
    lucide.createIcons();

    iconPickerBtn.addEventListener('click', (e) => {
      e.preventDefault();
      iconPickerPopover.classList.toggle('hidden');
      if (!iconPickerPopover.classList.contains('hidden')) {
        iconSearch.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (!iconPickerBtn.contains(e.target) && !iconPickerPopover.contains(e.target)) {
        iconPickerPopover.classList.add('hidden');
      }
    });

    function renderIcons(searchQuery = '') {
      iconGrid.innerHTML = '';
      const filtered = CURATED_ICONS.filter(name => name.includes(searchQuery.toLowerCase()));
      
      if (filtered.length === 0) {
        iconGrid.innerHTML = `<div class="col-span-4 text-center py-8 text-sm text-slate-400">No icons found</div>`;
        return;
      }

      filtered.forEach(name => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isSelected = iconNameInput.value === name;
        btn.className = `flex flex-col items-center justify-center p-3 gap-2 rounded-xl border transition-all ${isSelected ? 'bg-teal-50 border-teal-200 text-teal-700 shadow-sm' : 'border-transparent text-slate-600 hover:bg-teal-50 hover:border-teal-100 hover:text-teal-700'}`;
        btn.innerHTML = `<i data-lucide="${name}" class="w-5 h-5"></i><span class="text-[10px] truncate w-full text-center">${name}</span>`;
        btn.addEventListener('click', () => {
          iconNameInput.value = name;
          selectedIconText.textContent = name;
          selectedIconPreview.innerHTML = `<i data-lucide="${name}"></i>`;
          iconPickerPopover.classList.add('hidden');
          lucide.createIcons();
          renderIcons(iconSearch.value); 
        });
        iconGrid.appendChild(btn);
      });
      lucide.createIcons();
    }

    iconSearch.addEventListener('input', (e) => {
      renderIcons(e.target.value);
    });

    renderIcons();
  }
</script>

