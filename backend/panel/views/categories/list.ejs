<%- include('../partials/head', { title, user, currentPath, flash }) %>

<section class="panel" aria-label="Categories catalog">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Catalog</p>
      <h2>Categories</h2>
    </div>
    <a class="button primary" href="/categories/new" id="new-category-btn">+ New Category</a>
  </div>

  <div class="category-grid">
    <% categories.forEach((category) => { %>
      <article class="category-card" aria-label="Category: <%= category.name %>">
        <div class="category-top">
          <div>
            <h3><%= category.name %></h3>
            <p><small class="muted"><%= category.slug %></small></p>
          </div>
          <%- include('../partials/status-badge', { status: category.is_active ? 'active' : 'inactive' }) %>
        </div>
        <p class="muted"><%= category.description || 'No description provided.' %></p>
        <div class="meta-row">
          <span><%= category.supplier_count %> suppliers</span>
          <span><%= category.subcategories.length %> subcategories</span>
        </div>
        <% if (category.tags && category.tags.length) { %>
          <div class="tag-row" aria-label="Tags">
            <% category.tags.forEach((tag) => { %>
              <span><%= tag %></span>
            <% }) %>
          </div>
        <% } %>
        <% if (category.subcategories && category.subcategories.length) { %>
          <div class="sub-list" aria-label="Subcategories">
            <% category.subcategories.slice(0, 5).forEach((subcategory) => { %>
              <small><%= subcategory.name %></small>
            <% }) %>
            <% if (category.subcategories.length > 5) { %>
              <small class="muted">+<%= category.subcategories.length - 5 %> more</small>
            <% } %>
          </div>
        <% } %>
        <a class="button small" href="/categories/<%= category.id %>/edit" aria-label="Manage <%= category.name %>">Manage →</a>
      </article>
    <% }) %>
    <% if (!categories.length) { %>
      <div class="empty-panel" role="status">No categories created yet. <a href="/categories/new">Create your first →</a></div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer', { user }) %>
